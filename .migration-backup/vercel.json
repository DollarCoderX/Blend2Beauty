{
  "buildCommand": "pnpm --filter @workspace/blend2beauty run build",
  "outputDirectory": "artifacts/blend2beauty/dist/public",
  "installCommand": "npm install -g pnpm && pnpm install",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
